# Copy to .env and fill in. Never commit .env.

# Retell dashboard → Settings → API Keys (secret key, not the public key)
RETELL_API_KEY=

# n8n Cloud instance domain, without https://
N8N_DOMAIN=your-instance.app.n8n.cloud
# n8n → Settings → Instance-level MCP → Connect a client (access token)
N8N_API_KEY=

# Telegram bot token from @BotFather, and the chat that receives post-call notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
