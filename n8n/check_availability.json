    },
    {
      "id": "2d260023-5815-4030-9e24-dfef6064aa3f",
      "name": "Read Requested Date",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "date",
